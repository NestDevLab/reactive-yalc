{
  "name": "@reactive-yalc/ui",
  "version": "0.1.0",
  "description": "Reactive YALC - generic, brandable React components shared across apps",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NestDevLab/reactive-yalc.git"
  },
  "bugs": {
    "url": "https://github.com/NestDevLab/reactive-yalc/issues"
  },
  "homepage": "https://github.com/NestDevLab/reactive-yalc#readme",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "ci:checks": "npm run typecheck && npm run build && npm pack --dry-run",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "prepublishOnly": "npm run ci:checks"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "~5.8.2"
  }
}
