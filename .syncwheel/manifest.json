{
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    },
    "claims": "advisory"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "conversation-surface"
    ],
    "strategy": "cherry-pick"
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "id": "conversation-surface",
      "branch": "pr/conversation-surface",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {}
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": ".syncwheel/wt",
  "version": 2
}
